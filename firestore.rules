rules_version = '2';

// Reglas de seguridad de Mi Trayectoria.
// Se pegan en la consola de Firebase: Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    // Cuenta con el correo confirmado. Las cuentas de Google ya vienen confirmadas;
    // las de correo y contraseña, después de tocar el link del mail.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // La administradora es quien tiene un documento con su UID en la colección "admins".
    // Ese documento se crea a mano desde la consola de Firebase.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(me()));
    }

    // Cuentas bloqueadas por la administradora: no pueden publicar ni mandar pedidos.
    function notBlocked() {
      return !exists(/databases/$(database)/documents/blocked/$(me()));
    }

    function employerPath(uid) {
      return /databases/$(database)/documents/employers/$(uid);
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    function requestPath(employerId, workerId) {
      return /databases/$(database)/documents/requests/$(employerId + '_' + workerId);
    }

    // ¿La persona aceptó el pedido de entrevista de esta familia?
    function accepted(employerId, workerId) {
      return exists(requestPath(employerId, workerId))
        && get(requestPath(employerId, workerId)).data.status == 'accepted';
    }

    // WhatsApp argentino: 10 números (código de área + número, sin 0 ni 15).
    function validContact(d) {
      return d.keys().hasOnly(['whatsapp'])
        && d.whatsapp is string && d.whatsapp.matches('^[0-9]{10}$');
    }

    function validTasks(t) {
      return t is list && t.size() >= 1 && t.size() <= 6
        && t.toSet().hasOnly(['Limpieza y organización', 'Cocina', 'Planchado', 'Cuidado de niños', 'Cuidado de personas mayores', 'Otras tareas']);
    }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'locality', 'years', 'bio', 'tasks', 'mode', 'contact', 'photo', 'updatedAt'])
        && d.keys().hasAll(['name', 'locality', 'years', 'bio', 'tasks', 'mode', 'contact', 'photo', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.locality is string && d.locality.size() >= 1 && d.locality.size() <= 60
        && d.years in ['lt1', '1-3', '4-10', '10+']
        && d.bio is string && d.bio.size() <= 400
        && validTasks(d.tasks)
        && d.mode in ['con-retiro', 'sin-retiro', 'horas']
        && d.contact in ['whatsapp', 'pedido']
        && d.photo is string && d.photo.size() < 150000
        && (d.photo == '' || d.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
        && d.updatedAt == request.time;
    }

    function validEmployer(d) {
      return d.keys().hasOnly(['name', 'locality', 'tasks', 'about', 'updatedAt'])
        && d.keys().hasAll(['name', 'locality', 'tasks', 'about', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.locality is string && d.locality.size() >= 1 && d.locality.size() <= 60
        && validTasks(d.tasks)
        && d.about is string && d.about.size() <= 400
        && d.updatedAt == request.time;
    }

    // ---------- Perfiles de quienes buscan trabajo ----------
    // Los ve cualquiera que haya entrado con una cuenta confirmada.
    match /profiles/{uid} {
      allow read: if verified();
      allow create: if verified() && me() == uid && notBlocked()
        && !exists(employerPath(uid))
        && validProfile(request.resource.data);
      allow update: if verified() && me() == uid && notBlocked() && validProfile(request.resource.data);
      allow delete: if signedIn() && (me() == uid || isAdmin());

      // WhatsApp privado: lo ve la persona, la administradora, la familia cuyo pedido fue aceptado,
      // y, si la persona eligió "que me escriban directo", cualquier familia registrada y no bloqueada.
      match /private/{docId} {
        allow read: if signedIn() && (me() == uid || isAdmin() || accepted(me(), uid)
          || (verified() && notBlocked() && exists(employerPath(me()))
              && get(profilePath(uid)).data.contact == 'whatsapp'));
        allow create, update: if verified() && me() == uid && notBlocked()
          && docId == 'contact' && validContact(request.resource.data);
        allow delete: if signedIn() && (me() == uid || isAdmin());
      }
    }

    // ---------- Perfiles de familias (quienes buscan a alguien) ----------
    match /employers/{uid} {
      allow read: if verified();
      allow create: if verified() && me() == uid && notBlocked()
        && !exists(profilePath(uid))
        && validEmployer(request.resource.data);
      allow update: if verified() && me() == uid && notBlocked() && validEmployer(request.resource.data);
      allow delete: if signedIn() && (me() == uid || isAdmin());

      // WhatsApp privado de la familia: lo ve la persona que aceptó su pedido.
      match /private/{docId} {
        allow read: if signedIn() && (me() == uid || isAdmin() || accepted(uid, me()));
        allow create, update: if verified() && me() == uid && notBlocked()
          && docId == 'contact' && validContact(request.resource.data);
        allow delete: if signedIn() && (me() == uid || isAdmin());
      }
    }

    // ---------- Pedidos de entrevista ----------
    // El ID es "<familia>_<persona>": un solo pedido por pareja.
    match /requests/{rid} {
      allow read: if signedIn() && (resource.data.employerId == me() || resource.data.workerId == me() || isAdmin());

      allow create: if verified() && notBlocked()
        && exists(employerPath(me()))
        && rid == me() + '_' + request.resource.data.workerId
        && request.resource.data.keys().hasOnly(['employerId', 'workerId', 'employerName', 'employerLocality', 'workerName', 'message', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['employerId', 'workerId', 'employerName', 'employerLocality', 'workerName', 'message', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.employerId == me()
        && request.resource.data.workerId is string
        && exists(profilePath(request.resource.data.workerId))
        && request.resource.data.employerName == get(employerPath(me())).data.name
        && request.resource.data.employerLocality == get(employerPath(me())).data.locality
        && request.resource.data.workerName is string && request.resource.data.workerName.size() <= 60
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Solo la persona que recibe el pedido responde, una sola vez: acepta o no acepta.
      allow update: if verified()
        && resource.data.workerId == me()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.updatedAt == request.time;

      // La familia puede cancelar un pedido que todavía no fue respondido.
      allow delete: if signedIn() && (isAdmin() || (resource.data.employerId == me() && resource.data.status == 'pending'));
    }

    // ---------- Registro de acciones (para las estadísticas) ----------
    // Cada cuenta anota sus propias acciones; nadie puede cambiarlas ni borrarlas.
    // Los contactos por WhatsApp usan un ID fijo para contarse una sola vez por pareja.
    match /events/{eid} {
      allow read: if isAdmin() || (signedIn() && resource.data.actor == me());
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['type', 'actor', 'target', 'at'])
        && request.resource.data.keys().hasAll(['type', 'actor', 'target', 'at'])
        && request.resource.data.actor == me()
        && request.resource.data.type in ['profile_created', 'profile_deleted', 'family_created', 'family_deleted',
             'whatsapp_click', 'request_sent', 'request_accepted', 'request_rejected', 'request_canceled']
        && request.resource.data.target is string && request.resource.data.target.size() <= 128
        && request.resource.data.at == request.time
        && (request.resource.data.type != 'whatsapp_click' || eid == 'wa_' + me() + '_' + request.resource.data.target);
      allow update, delete: if false;
    }

    // ---------- Bloqueos (solo la administradora) ----------
    match /blocked/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Cada persona solo puede consultar si ella misma es administradora. Nadie puede escribir desde la página.
    match /admins/{uid} {
      allow read: if signedIn() && me() == uid;
      allow write: if false;
    }
  }
}
